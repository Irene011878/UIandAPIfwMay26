<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Suite">

    <!-- UI REGRESSION TESTS -->
    <test name="UI Regression">

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="testCases.ui.account"/>
            <package name="testCases.ui.cart"/>
            <package name="testCases.ui.checkout"/>
            <package name="testCases.ui.products"/>
            <package name="testCases.ui.contact"/>
            <package name="testCases.ui.navigation"/>
            <package name="testCases.ui.subscription"/>
        </packages>

    </test>

    <!-- API REGRESSION TESTS -->
    <test name="API Regression">

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="testCases.api.products"/>
            <package name="testCases.api.authentication"/>
            <package name="testCases.api.users"/>
            <package name="testCases.api.brands"/>
        </packages>

    </test>

</suite>